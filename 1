using System;
using System.Data;
using System.Data.SQLite;
using System.Drawing;
using System.Windows.Forms;

namespace SupportDesk.forms
{
    public partial class DormitoryForm : Form
    {
        private readonly string _connectionString;
        private int? _selectedRoomId = null;

        public DormitoryForm(string connectionString)
        {
            InitializeComponent();
            _connectionString = connectionString;

            // Подписка на события
            btnSearch.Click += (s, e) => LoadRooms();
            btnRefresh.Click += (s, e) => { txtSearch.Clear(); cmbFloor.SelectedIndex = 0; cmbStatus.SelectedIndex = 0; LoadRooms(); };
            btnAddRoom.Click += BtnAddRoom_Click;
            btnEditRoom.Click += BtnEditRoom_Click;
            btnDeleteRoom.Click += BtnDeleteRoom_Click;
            btnAddResident.Click += BtnAddResident_Click;
            btnEditResident.Click += BtnEditResident_Click;
            btnEvict.Click += BtnEvict_Click;
            dgvRooms.SelectionChanged += DgvRooms_SelectionChanged;
            txtSearch.KeyDown += (s, e) => { if (e.KeyCode == Keys.Enter) { e.SuppressKeyPress = true; LoadRooms(); } };

            EnsureTablesExist();
            LoadFilters();
            LoadRooms();
        }

        // ==================== Создание таблиц ====================
        private void EnsureTablesExist()
        {
            using (var conn = new SQLiteConnection(_connectionString))
            {
                conn.Open();

                string sqlRooms = @"
                    CREATE TABLE IF NOT EXISTS DormRooms (
                        Id INTEGER PRIMARY KEY AUTOINCREMENT,
                        RoomNumber TEXT NOT NULL UNIQUE,
                        Floor INTEGER NOT NULL,
                        Capacity INTEGER NOT NULL DEFAULT 2,
                        Status TEXT NOT NULL DEFAULT 'Свободна',
                        Notes TEXT
                    );";

                string sqlResidents = @"
                    CREATE TABLE IF NOT EXISTS DormResidents (
                        Id INTEGER PRIMARY KEY AUTOINCREMENT,
                        RoomId INTEGER NOT NULL,
                        FullName TEXT NOT NULL,
                        Phone TEXT,
                        Faculty TEXT,
                        Course INTEGER,
                        CheckInDate TEXT DEFAULT CURRENT_TIMESTAMP,
                        Notes TEXT,
                        FOREIGN KEY (RoomId) REFERENCES DormRooms(Id) ON DELETE CASCADE
                    );";

                using (var cmd = new SQLiteCommand(sqlRooms, conn)) cmd.ExecuteNonQuery();
                using (var cmd = new SQLiteCommand(sqlResidents, conn)) cmd.ExecuteNonQuery();
            }
        }

        // ==================== Фильтры ====================
        private void LoadFilters()
        {
            cmbFloor.Items.Clear();
            cmbFloor.Items.Add("Все этажи");
            for (int i = 1; i <= 10; i++)
                cmbFloor.Items.Add(i.ToString());
            cmbFloor.SelectedIndex = 0;

            cmbStatus.Items.Clear();
            cmbStatus.Items.AddRange(new object[] { "Все статусы", "Свободна", "Занята", "На ремонте" });
            cmbStatus.SelectedIndex = 0;
        }

        // ==================== Загрузка комнат ====================
        private void LoadRooms()
        {
            try
            {
                using (var conn = new SQLiteConnection(_connectionString))
                {
                    conn.Open();

                    string sql = @"
                        SELECT 
                            r.Id,
                            r.RoomNumber AS [№ комнаты],
                            r.Floor AS [Этаж],
                            r.Capacity AS [Мест],
                            COUNT(res.Id) AS [Жильцов],
                            r.Status AS [Статус],
                            r.Notes AS [Примечание]
                        FROM DormRooms r
                        LEFT JOIN DormResidents res ON res.RoomId = r.Id
                        WHERE 1=1";

                    if (!string.IsNullOrWhiteSpace(txtSearch.Text))
                        sql += " AND (r.RoomNumber LIKE @search OR res.FullName LIKE @search)";

                    if (cmbFloor.SelectedIndex > 0)
                        sql += " AND r.Floor = @floor";

                    if (cmbStatus.SelectedIndex > 0)
                        sql += " AND r.Status = @status";

                    sql += " GROUP BY r.Id ORDER BY r.Floor, r.RoomNumber";

                    using (var cmd = new SQLiteCommand(sql, conn))
                    {
                        if (!string.IsNullOrWhiteSpace(txtSearch.Text))
                            cmd.Parameters.AddWithValue("@search", "%" + txtSearch.Text.Trim() + "%");
                        if (cmbFloor.SelectedIndex > 0)
                            cmd.Parameters.AddWithValue("@floor", int.Parse(cmbFloor.SelectedItem.ToString()));
                        if (cmbStatus.SelectedIndex > 0)
                            cmd.Parameters.AddWithValue("@status", cmbStatus.SelectedItem.ToString());

                        DataTable dt = new DataTable();
                        using (var adapter = new SQLiteDataAdapter(cmd))
                            adapter.Fill(dt);

                        dgvRooms.DataSource = dt;
                        if (dgvRooms.Columns.Contains("Id"))
                            dgvRooms.Columns["Id"].Visible = false;

                        lblStatus.Text = $"Комнат: {dt.Rows.Count}";
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Ошибка загрузки комнат:\n" + ex.Message, "Ошибка",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        // ==================== Выбор комнаты ====================
        private void DgvRooms_SelectionChanged(object sender, EventArgs e)
        {
            if (dgvRooms.CurrentRow == null || dgvRooms.CurrentRow.Cells["Id"].Value == null)
            {
                _selectedRoomId = null;
                dgvResidents.DataSource = null;
                return;
            }

            _selectedRoomId = Convert.ToInt32(dgvRooms.CurrentRow.Cells["Id"].Value);
            LoadResidents(_selectedRoomId.Value);
        }

        private void LoadResidents(int roomId)
        {
            try
            {
                using (var conn = new SQLiteConnection(_connectionString))
                {
                    conn.Open();
                    string sql = @"
                        SELECT 
                            Id,
                            FullName AS [ФИО],
                            Phone AS [Телефон],
                            Faculty AS [Факультет],
                            Course AS [Курс],
                            CheckInDate AS [Дата заезда],
                            Notes AS [Примечание]
                        FROM DormResidents 
                        WHERE RoomId = @roomId
                        ORDER BY FullName";

                    using (var cmd = new SQLiteCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@roomId", roomId);
                        DataTable dt = new DataTable();
                        using (var adapter = new SQLiteDataAdapter(cmd))
                            adapter.Fill(dt);

                        dgvResidents.DataSource = dt;
                        if (dgvResidents.Columns.Contains("Id"))
                            dgvResidents.Columns["Id"].Visible = false;
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Ошибка загрузки жильцов:\n" + ex.Message, "Ошибка",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        // ==================== Работа с комнатами ====================
        private void BtnAddRoom_Click(object sender, EventArgs e)
        {
            using (var form = new RoomEditForm(_connectionString, null))
            {
                if (form.ShowDialog() == DialogResult.OK)
                    LoadRooms();
            }
        }

        private void BtnEditRoom_Click(object sender, EventArgs e)
        {
            if (_selectedRoomId == null)
            {
                MessageBox.Show("Выберите комнату.", "Внимание", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            using (var form = new RoomEditForm(_connectionString, _selectedRoomId))
            {
                if (form.ShowDialog() == DialogResult.OK)
                    LoadRooms();
            }
        }

        private void BtnDeleteRoom_Click(object sender, EventArgs e)
        {
            if (_selectedRoomId == null) return;

            if (MessageBox.Show("Удалить комнату и всех её жильцов?", "Подтверждение",
                MessageBoxButtons.YesNo, MessageBoxIcon.Question) != DialogResult.Yes) return;

            try
            {
                using (var conn = new SQLiteConnection(_connectionString))
                {
                    conn.Open();
                    using (var cmd = new SQLiteCommand("DELETE FROM DormRooms WHERE Id = @id", conn))
                    {
                        cmd.Parameters.AddWithValue("@id", _selectedRoomId.Value);
                        cmd.ExecuteNonQuery();
                    }
                }
                _selectedRoomId = null;
                LoadRooms();
                dgvResidents.DataSource = null;
            }
            catch (Exception ex)
            {
                MessageBox.Show("Ошибка удаления:\n" + ex.Message, "Ошибка",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        // ==================== Работа с жильцами ====================
        private void BtnAddResident_Click(object sender, EventArgs e)
        {
            if (_selectedRoomId == null)
            {
                MessageBox.Show("Сначала выберите комнату.", "Внимание",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            using (var form = new ResidentEditForm(_connectionString, _selectedRoomId.Value, null))
            {
                if (form.ShowDialog() == DialogResult.OK)
                {
                    LoadResidents(_selectedRoomId.Value);
                    LoadRooms(); // обновить количество жильцов
                }
            }
        }

        private void BtnEditResident_Click(object sender, EventArgs e)
        {
            if (dgvResidents.CurrentRow == null) return;

            int residentId = Convert.ToInt32(dgvResidents.CurrentRow.Cells["Id"].Value);

            using (var form = new ResidentEditForm(_connectionString, _selectedRoomId.Value, residentId))
            {
                if (form.ShowDialog() == DialogResult.OK)
                    LoadResidents(_selectedRoomId.Value);
            }
        }

        private void BtnEvict_Click(object sender, EventArgs e)
        {
            if (dgvResidents.CurrentRow == null) return;

            if (MessageBox.Show("Выселить выбранного жильца?", "Подтверждение",
                MessageBoxButtons.YesNo, MessageBoxIcon.Question) != DialogResult.Yes) return;

            int residentId = Convert.ToInt32(dgvResidents.CurrentRow.Cells["Id"].Value);

            try
            {
                using (var conn = new SQLiteConnection(_connectionString))
                {
                    conn.Open();
                    using (var cmd = new SQLiteCommand("DELETE FROM DormResidents WHERE Id = @id", conn))
                    {
                        cmd.Parameters.AddWithValue("@id", residentId);
                        cmd.ExecuteNonQuery();
                    }
                }
                LoadResidents(_selectedRoomId.Value);
                LoadRooms();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Ошибка выселения:\n" + ex.Message, "Ошибка",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }
    }
}
